<!DOCTYPE html>
<html>
<head>
<title>Nanna ❤️ Sai</title>

<style>
body {
    margin: 0;
    font-family: 'Arial', sans-serif;
    background: linear-gradient(135deg, #ff758c, #ff7eb3);
    text-align: center;
    color: white;
    overflow: hidden;
}

.container {
    padding: 40px;
    position: relative;
    z-index: 2;
}

h1 {
    font-size: 45px;
}

.section {
    background: rgba(255,255,255,0.2);
    padding: 20px;
    margin: 20px auto;
    width: 80%;
    border-radius: 20px;
}

button {
    padding: 15px 30px;
    font-size: 18px;
    background-color: #ff1e56;
    color: white;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    margin: 10px;
}

button:hover {
    background-color: #ff0040;
}

#proposal {
    display: none;
    margin-top: 20px;
    font-size: 24px;
}

.heart {
    position: absolute;
    color: #fff;
    font-size: 20px;
    animation: float 5s linear infinite;
}

@keyframes float {
    0% { transform: translateY(100vh); opacity: 1; }
    100% { transform: translateY(-10vh); opacity: 0; }
}
</style>
</head>

<body>

<!-- Background Music -->
<audio autoplay loop>
  <source src="https://www.bensound.com/bensound-music/bensound-romantic.mp3" type="audio/mp3">
</audio>

<div class="container">

<h1>Happy Valentine's Day Nanna ❤️</h1>
<h3>From Your Sai 💖</h3>

<div class="section">
<h2>Our Story ✨</h2>
<p>
From our first college outing…  
To Tirumala prayers…  
To Pondicherry beaches…  
To our Hyderabad days together…  

Every memory with you is my favorite chapter.
</p>
</div>

<div class="section">
<h2>My Heart Says 💕</h2>
<p>
You are my peace.  
You are my happiness.  
You are my forever.
</p>

<h2>Will You Always Be Mine? 💍</h2>

<button onclick="yesClicked()">Yes ❤️</button>
<button onmouseover="moveButton(this)">No 😜</button>

<div id="proposal">
Yayyyyy 🥹❤️  
Forever Yours,  
<br><br>
💖 Sai 💖
</div>

</div>
</div>

<script>
function yesClicked() {
    document.getElementById("proposal").style.display = "block";
}

function moveButton(btn) {
    btn.style.position = "absolute";
    btn.style.top = Math.random() * window.innerHeight + "px";
    btn.style.left = Math.random() * window.innerWidth + "px";
}

// Floating Hearts Generator
setInterval(function(){
    var heart = document.createElement("div");
    heart.className = "heart";
    heart.innerHTML = "❤️";
    heart.style.left = Math.random() * 100 + "vw";
    heart.style.fontSize = (Math.random() * 20 + 10) + "px";
    document.body.appendChild(heart);

    setTimeout(function(){
        heart.remove();
    }, 5000);
}, 500);
</script>

</body>
</html>
